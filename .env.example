DATABASE_URL=postgresql+psycopg://parking:CHANGE_ME@127.0.0.1:5432/parking
# Match the port shown in pgAdmin; percent-encode special characters in passwords.
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# localhost HTTP only; enable for HTTPS hosting.
COOKIE_SECURE=false
# Used only by: python -m app.database seed-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Put this line in .env.test, not DATABASE_URL. Tests refuse any DB except parking_test.
# TEST_DATABASE_URL=postgresql+psycopg://parking:CHANGE_ME@127.0.0.1:5432/parking_test
USE_STUB=true
PLATE_MODEL=models/plate_detector.pt
OCR_MODEL_DIR=models/easyocr
